      {"id": "feeds", "sourceType": "hub", "targetType": "unit", "directTrueForm": "{source} feeds {target}", "directFalseForm": "{source} does not feed {target}", "inverseTrueForm": "{target} is fed by {source}", "inverseFalseForm": "{target} is not fed by {source}"}
