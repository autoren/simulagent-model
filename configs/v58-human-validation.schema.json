{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v58-human-validation.schema.json",
  "title": "V58 blinded validation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "validation_id",
    "submission_id",
    "anonymous_validator_id",
    "verdict",
    "inferred_canonical_ast_or_null",
    "construction_family_realized",
    "source_target_order_preserved_or_null",
    "notes_without_writer_identity",
    "timestamp"
  ],
  "properties": {
    "validation_id": {"type": "string", "minLength": 8},
    "submission_id": {"type": "string", "minLength": 8},
    "anonymous_validator_id": {"type": "string", "minLength": 8},
    "verdict": {
      "enum": [
        "equivalent_unique",
        "not_equivalent",
        "ambiguous",
        "unsupported",
        "malformed_or_meta"
      ]
    },
    "inferred_canonical_ast_or_null": {"type": ["object", "null"]},
    "construction_family_realized": {"type": "boolean"},
    "source_target_order_preserved_or_null": {"type": ["boolean", "null"]},
    "notes_without_writer_identity": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
