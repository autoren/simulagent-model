{
  "schemaVersion": "183-sgd-contract-identifiability-population-design",
  "experiment": "v183_text_free_full_contract_SGD_identifiability_population",
  "parentV182OutcomeLock": "configs/v182-triple-repetition-robust-planner-fresh-confirmation-outcome-lock.json",
  "sourceV134OutcomeLock": "configs/v134-semantic-novelty-source-design-outcome-lock.json",
  "sourceArchive": "outputs/v124-sgd-source-feasibility/source/sgd-pinned.tar.gz",
  "sourceCatalog": "outputs/v134-semantic-novelty-source-design/design/choice-catalog.json",
  "sourcePopulation": "outputs/v134-semantic-novelty-source-design/design/fixture-population.json",
  "roadmap": "docs/research-roadmap-after-v182.md",
  "claimBoundary": "text-free externally grounded SGD capability-contract identity and source-annotation identifiability screening only; source semantic frames are hidden benchmark-screening oracles, not deployed observations; this is not utterance understanding, model performance, protected evaluation, ontology truth, authority, action, or execution evidence",
  "capabilityIdentity": {
    "sourceDefinitionIdentity": "exact SGD service_name::intent_name",
    "capabilityContractIdentity": "SHA-256 of domain, normalized service and intent descriptions, normalized intent name, transactionality, required optional and result slots, and complete slot type/value-description hashes; service version labels are excluded",
    "deduplicateExactCapabilityContractsAcrossSourceDefinitions": true,
    "crossTruthKindContractCollisionMeansConfounded": true,
    "knownMeansExactContractDeclaredByOneOfSixFrozenV134KnownDefinitions": true,
    "provisionalMeansV134ValidUndeclaredSourceDefinitionWithNoDeclaredContractIdentity": true,
    "unsupportedMeansV134UnsupportedSourceDefinitionWithNoDeclaredContractIdentity": true,
    "absoluteNoveltyClaimAllowed": false
  },
  "hiddenIdentifiabilityProtocol": {
    "purpose": "conservative automatic benchmark screening before language extraction",
    "sourceSemanticFrameIsHiddenAndNeverModelInput": true,
    "observableFrameFields": [
      "normalized_active_intent_name",
      "current_action_slot_names",
      "current_state_slot_names",
      "current_requested_slot_names"
    ],
    "excludedFields": [
      "service_name",
      "domain",
      "source_definition_id",
      "truth_kind",
      "utterance",
      "dialogue_text",
      "slot_values",
      "character_spans"
    ],
    "compatibilityRule": "normalized intent names must match and every observed non-intent slot name must exist in the candidate capability contract",
    "singletonCompatibleContract": "IDENTIFIABLE",
    "multipleOrMixedCompatibleContracts": "INSUFFICIENT",
    "zeroCompatibleContracts": "INVALID_SOURCE_RECORD",
    "missingObservation": "INSUFFICIENT with complete contract universe retained",
    "targetContractMustAlwaysBeRetained": true,
    "compatibilityMayNotUsePresentedCandidateOrTruthKind": true,
    "screeningDoesNotEstablishUtteranceLevelHumanOrModelIdentifiability": true
  },
  "roleSplit": {
    "sourcePartition": "dev",
    "baseSalt": "simulagent-v183-sgd-contract-role-split-v1",
    "recordsPerTruthCandidateCell": 4,
    "developmentRecordsPerCell": 2,
    "protectedRecordsPerCell": 2,
    "requiredCellCount": 66,
    "requiredFixtureCountPerRole": 132,
    "requiredSourceRecordCountPerRole": 120,
    "requiredMissingControlCountPerRole": 12,
    "selectionUsesOnlyFrozenIdentifiersTruthCandidateCellsAndSalt": true,
    "selectionUsesNoLanguageCompatibilityOutcomeOrModelScore": true
  },
  "populationGates": {
    "requiredSourceFixtureCount": 264,
    "requiredSourceRecordCount": 240,
    "requiredMissingControlCount": 24,
    "requiredRoleCount": 2,
    "requiredFixtureCountPerRole": 132,
    "requiredSourceRecordCountPerRole": 120,
    "requiredMissingControlCountPerRole": 12,
    "requiredRecordsPerTruthCandidateCellPerRole": 2,
    "requiredRoleIdentifierOverlap": 0,
    "requiredSelectedSourceReconstructionRate": 1.0,
    "requiredTargetContractRetentionRate": 1.0,
    "requiredMissingControlInsufficientRate": 1.0,
    "requiredCrossTruthKindContractCollisionCount": 0,
    "minimumIdentifiableSourceRecordCountPerRole": 48,
    "minimumIdentifiableKnownRecordCountPerRole": 24,
    "minimumIdentifiableProvisionalRecordCountPerRole": 12,
    "minimumIdentifiableUnsupportedRecordCountPerRole": 6,
    "maximumInvalidSourceRecordCount": 0,
    "maximumPersistedUtteranceOrDialogueTextCount": 0,
    "maximumPersistedSlotValueOrSpanCount": 0,
    "maximumManualLanguageInspectionCount": 0,
    "maximumModelLoadCount": 0,
    "maximumModelGenerationCount": 0,
    "maximumAPICallCount": 0,
    "maximumTrainingRunCount": 0,
    "maximumOntologyRegistrationCount": 0,
    "maximumTrustedStateMutationCount": 0,
    "maximumServiceOrSensorCallCount": 0,
    "maximumExternalSideEffectCount": 0,
    "maximumActualExecutionCount": 0
  },
  "preLockExposure": {
    "archiveSchemaShapeInspectionCount": 1,
    "dialogueFrameShapeInspectionCount": 1,
    "perRecordCompatibilityCensusCount": 0,
    "formalPopulationBuildCount": 0,
    "utteranceOrDialogueTextEmissionCount": 0,
    "manualLanguageInspectionCount": 0,
    "modelLoadCount": 0,
    "modelGenerationCount": 0,
    "APICallCount": 0,
    "trainingRunCount": 0,
    "ontologyRegistrationCount": 0,
    "trustedStateMutationCount": 0,
    "serviceOrSensorCallCount": 0,
    "actualExecutionCount": 0
  },
  "authorityBoundary": {
    "allCapabilityContractsAreShadowOnly": true,
    "authoritativeOntologyAndStateRemainImmutable": true,
    "presentedCandidateIsFallibleContextOnly": true,
    "compatibilitySetsNeverPruneAuthoritativeHypotheses": true,
    "provisionalRegistrationAllowed": false,
    "languageExtractionAllowedDuringV183": false,
    "modelOrAPIAllowedDuringV183": false,
    "actionOrExecutionAllowed": false,
    "realExecutionCount": 0
  },
  "decisionRule": {
    "ifEveryPopulationAndIdentifiabilityGatePasses": "freeze_V183_and_authorize_separate_role_isolated_language_extraction_preregistration_only",
    "otherwise": "freeze_V183_boundary_result_without_language_extraction_or_model",
    "passAuthorizesImmediateLanguageExtraction": false,
    "passAuthorizesDeterministicPolicyOrModelRun": false,
    "passAuthorizesProtectedAccess": false,
    "passAuthorizesOntologyRegistrationAuthorityActionOrExecution": false
  }
}
