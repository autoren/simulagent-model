  "pricing": {
    "binaryQuestionAnchorCost": 0.10,
    "genericTrustedClarificationCost": 0.40,
    "maximumMultiwayTurns": 2,
    "bitSlotRule": "cost(k,o)=o+(0.10-o)*ceil(log2(k)), where k is the number of reachable answer categories",
    "turnOverheadGridNumeratorsInclusive": [0, 9],
    "turnOverheadGridDenominator": 100,
    "turnOverheadGridStep": 0.01,
    "entropyLowerBoundRule": "cost=0.10*H(answer|current version space) with zero turn overhead",
    "doNotEquateOneCategoricalAnswerWithOneBinaryBit": true,
    "costIsComputedBeforePolicyScoring": true
  },
  "policies": [
    "exact_adaptive_all_multiway_questions",
    "best_fixed_open_loop_all_multiway_questions",
    "exact_adaptive_coarse_questions_only",
    "always_generic_trusted_clarification"
  ],
  "feasibilityGates": {
    "requiredContractCount": 14,
    "requiredPositivePriorContractCount": 14,
    "requiredAllQuestionCount": 3,
    "requiredCoarseQuestionCount": 2,
    "requiredPricingScenarioCount": 11,
    "requiredObservedFinalExactnessRate": 1.0,
    "requiredTargetRetentionRate": 1.0,
    "requiredV187GenericCost": 0.40,
    "requiredPureBitSlotAllQuestionCostNotBelowGeneric": true,
    "minimumPositiveConditionalScenarioCount": 1,
    "maximumMeanTurnCount": 2.0,
    "maximumUtteranceOrDialogueLanguageReadCount": 0,
    "maximumProtectedUtteranceLanguageReadCount": 0,
    "maximumModelLoadCount": 0,
