    "maximumActualExecutionCount": 0
  },
  "interpretationRule": {
    "robustMultiwayValueRequiresStrictImprovementUnderPureBitSlotUpperPricing": true,
    "conditionalMultiwayValueMeansImprovementOnlyWithPositiveTurnOverheadOrEntropyLowerBound": true,
    "coarseOnlyControlMustBeReportedSeparately": true,
    "globalIntentMenuBenefitMustNotBeCalledAdaptiveIfExactAndOpenLoopTie": true
  },
  "decisionRule": {
    "ifRobustMultiwayValuePasses": "freeze_robust_multiway_feasibility_and_authorize_separate_clean_protocol_design_only",
