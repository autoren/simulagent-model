  "roadmap": "docs/research-roadmap-after-v202.md",
  "claimBoundary": "metadata-and-schema-only feasibility of a genuinely partition-independent confirmation population for the exact frozen 14 semantic contracts; source annotations are benchmark-screening labels, not proof of utterance-alone human identifiability; not language extraction, model performance, protected evidence, ontology truth, authority, action, or execution",
  "exactContractIdentity": {
    "rule": "reuse the frozen V183 semantic capability-contract hash over domain, normalized schema descriptions, normalized intent name, transactionality, slot sets, and complete slot metadata",
    "intentNameSimilarityIsInsufficient": true,
    "serviceVersionLabelIsExcludedFromIdentity": true,
    "allCandidateMappingsMustBeSingleton": true
  },
  "independenceContract": {
    "eligibleSourceFamily": "SGD_SAME_REVISION_NON_DEV_EXACT_CONTRACTS",
    "allowedPartitions": ["train", "test"],
    "forbiddenPartitions": ["dev"],
    "excludeEveryV183SourceRecordAndPartitionDialogue": true,
    "excludeEveryV191SourceRecordAndPartitionDialogue": true,
    "selectedPartitionDialogueKeysMustBeUnique": true,
    "minimumUniqueDialoguesPerContract": 6,
    "requiredContractCount": 14,
    "requiredSourceRecordsPerContract": 6,
    "futureSelectionMayUseOnlyFrozenIdentifiersContractMappingAndSalt": true,
    "futureSelectionSalt": "simulagent-v204-independent-top3-controller-confirmation-v1"
  },
  "candidateFamilies": [
    {
      "familyId": "SGD_SAME_REVISION_NON_DEV_EXACT_CONTRACTS",
      "evaluation": "exact schema-contract and source-annotation census over frozen train/test candidate metadata",
      "eligibleForSelection": true
    },
    {
      "familyId": "SGD_MIXED_PARTITION_REMAINDER_DIAGNOSTIC",
      "evaluation": "exact schema-contract census after prior exclusions across dev/train/test",
      "eligibleForSelection": false,
      "reason": "diagnostic only because reuse of the development partition is not partition-independent"
    },
    {
      "familyId": "TASKMASTER_1_FROZEN_V87",
      "evaluation": "reuse frozen V87 source-gate result",
      "eligibleForSelection": false
    },
    {
      "familyId": "MULTIWOZ_REFERENCE_FROZEN_V87",
      "evaluation": "reuse frozen V87 source-gate result",
      "eligibleForSelection": false
    }
  ],
  "qualificationGates": {
    "requiredExactContractCoverage": 14,
    "minimumUniquePartitionDialoguesPerContract": 6,
    "requiredSingletonSourceAnnotationMappingRate": 1.0,
    "requiredPriorSourceRecordOverlap": 0,
    "requiredPriorPartitionDialogueOverlap": 0,
    "requiredAllowedPartitionRate": 1.0,
    "requiredLicensedIndependentHumanLanguageSourceGate": true,
    "requiredCompleteTargetExpressibility": true
  },
  "accessGates": {
    "requiredArchiveReadCount": 1,
    "requiredSchemaMetadataFileReadCount": 3,
    "requiredCandidateInventoryReadCount": 1,
    "requiredConsumedIdentityArtifactReadCount": 2,
    "maximumUtteranceOrDialogueTextReadOrEmissionCount": 0,
