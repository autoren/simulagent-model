  },
  "preLockExposure": {
    "aggregateV191AvailabilityReadCount": 1,
    "frozenSourceGateResultReadCount": 1,
    "formalExactCrossPartitionContractCensusCount": 0,
    "utteranceOrDialogueTextReadOrEmissionCount": 0,
