{
  "schemaVersion": "77-clarification-benchmark-design",
  "experiment": "v77_local_first_structured_llm_clarification_benchmark",
  "purpose": "project-authored, model-free development benchmark for separating interpretation proposals, belief weighting, and decisions",
  "hypothesesInTieBreakOrder": [
    "q2_report__jordan_lee",
    "annual_report__jordan_lee",
    "q2_report__jordan_patel",
    "annual_report__jordan_patel",
    "none_of_the_above"
  ],
  "actionsInTieBreakOrder": [
    "ask_report",
    "ask_recipient",
    "ask_full_details",
    "draft_q2_lee",
    "draft_annual_lee",
    "draft_q2_patel",
    "draft_annual_patel",
    "send_q2_lee",
    "send_annual_lee",
    "send_q2_patel",
    "send_annual_patel",
    "safe_draft",
    "abstain"
  ],
  "observationsInSourceOrder": [
    "report_q2",
    "report_annual",
    "report_other",
    "recipient_lee",
    "recipient_patel",
    "recipient_other",
    "full_q2_lee",
    "full_annual_lee",
    "full_q2_patel",
    "full_annual_patel",
    "full_other",
    "draft_approved",
    "draft_rejected",
    "done"
  ],
  "statesInSourceOrder": ["active", "terminal"],
  "sharedParameters": {
    "horizonActions": 3,
    "discount": 1.0,
    "tieTolerance": 1e-12,
    "focusedQuestionReliability": 0.96,
    "fullQuestionReliability": 0.96,
    "matchingDraftApprovalProbability": 0.9,
    "nonmatchingDraftApprovalProbability": 0.1,
    "irreversibleSendMinimumMatchingPosterior": 0.9,
    "irreversibleSendMaximumNonePosterior": 0.1
  },
  "positiveRewardProfile": {
    "askReport": -1.0,
    "askRecipient": -1.0,
    "askFullDetails": -4.5,
    "candidateDraft": -0.5,
    "correctSend": 12.0,
    "wrongOrUnsupportedSend": -35.0,
    "safeDraft": -2.0,
    "abstain": -4.0
  },
  "dominantControlRewardProfile": {
    "askReport": -1.0,
    "askRecipient": -1.0,
    "askFullDetails": -4.5,
    "candidateDraft": -0.5,
    "everySend": 4.0,
    "safeDraft": 5.0,
    "abstain": -4.0
  },
  "fixtures": [
    {
      "name": "ambiguous_send",
      "syntheticInstruction": "Send the final report to Jordan.",
      "rewardProfile": "positive",
      "prior": [0.2375, 0.2375, 0.2375, 0.2375, 0.05]
    },
    {
      "name": "clear_send",
      "syntheticInstruction": "Send the Q2 report to Jordan Lee now.",
      "rewardProfile": "positive",
      "prior": [0.995, 0.00125, 0.00125, 0.00125, 0.00125]
    },
    {
      "name": "unknown_heavy",
      "syntheticInstruction": "Send the special report to the other Jordan.",
      "rewardProfile": "positive",
      "prior": [0.15, 0.15, 0.15, 0.15, 0.4]
    },
    {
      "name": "dominant_safe_draft",
      "syntheticInstruction": "Prepare whatever is safest for Jordan.",
      "rewardProfile": "dominant_control",
      "prior": [0.2375, 0.2375, 0.2375, 0.2375, 0.05]
    }
  ],
  "benchmarkGates": {
    "requiredFixtureCount": 4,
    "requiredHypothesisCount": 5,
    "requiredNoneHypothesis": "none_of_the_above",
    "requiredAmbiguousRootActionSet": ["ask_report", "ask_recipient"],
    "requiredAmbiguousReachableInformationActions": ["ask_report", "ask_recipient"],
    "minimumAmbiguousNormalizedMAPRegret": 0.05,
    "minimumAmbiguousNormalizedActImmediatelyRegret": 0.05,
    "requiredClearRootAction": "send_q2_lee",
    "minimumClearNormalizedAskAlwaysRegret": 0.02,
    "requiredUnknownRootActionSet": [
      "ask_report",
      "ask_recipient",
      "ask_full_details"
    ],
    "requiredUnknownContinuationActionSet": ["safe_draft", "abstain"],
    "maximumUnknownBranchIrreversibleSendCount": 0,
    "requiredDominantRootAction": "safe_draft",
    "maximumDominantNormalizedMAPRegret": 1e-12,
    "maximumDominantNormalizedPosteriorSamplingRegret": 1e-12,
    "minimumObservationNormalizationRate": 1.0,
    "minimumIdenticalHypothesisSupportRate": 1.0,
    "minimumBeliefNormalizationRate": 1.0,
    "maximumOffSupportFallbackCount": 0,
    "maximumModelForwardPassCount": 0,
    "maximumAPICallCount": 0,
    "maximumAdapterTrainingRunCount": 0,
    "maximumHumanRecordAccessCount": 0,
    "maximumExternalSideEffectCount": 0
  },
  "controls": [
    "exact_posterior_aware",
    "map_interpretation",
    "persistent_posterior_sampling",
    "act_immediately",
    "ask_always",
    "best_open_loop",
    "oracle_interpretation"
  ],
  "claimBoundary": {
    "projectAuthoredDevelopmentMechanism": true,
    "exactFiniteBenchmark": true,
    "modelFreeStage": true,
    "localModelEvidence": false,
    "APIModelEvidence": false,
    "humanLanguageEvidence": false,
    "externalBenchmarkEvidence": false,
    "openWorldSafety": false,
    "executionAuthority": false
  },
  "decisionRule": {
    "ifEveryGatePasses": "freeze the model-free benchmark and authorize preregistration of frozen local-model candidate generation",
    "ifAnyGateFails": "freeze a model-free benchmark-design failure without tuning this population",
    "passAuthorizesLocalModelForwardPassesImmediately": false,
    "passAuthorizesAPIAccess": false,
    "passAuthorizesLoRA": false,
    "passAuthorizesLearnedLikelihoods": false,
    "passAuthorizesExecutionAuthority": false
  },
  "stageAuthorization": {
    "auditAndFreezeDesign": true,
    "implementBenchmark": false,
    "computePlannerOutcomes": false,
    "accessLocalModel": false,
    "accessAPIModel": false,
    "trainAdapter": false,
    "collectHumanLanguage": false,
    "performExternalSideEffect": false
  }
