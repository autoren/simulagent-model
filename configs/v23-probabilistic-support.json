    "emptyPosteriorPolicy": "complete_outcome_vocabulary",
    "maximumUnknownAtomsPerProposal": 4
  },
  "branchBudgets": [1, 4, 16, 64],
  "credibleProgramMasses": [0.5, 0.8, 0.95, 1.0],
  "registeredReference": {
    "branchBudget": 64,
    "credibleProgramMass": 0.95
  },
  "metrics": [
    "target_nonzero_posterior_retention",
    "target_credible_set_retention",
    "empty_posterior_rate",
    "credible_program_count",
    "transition_set_exact_match",
    "complete_episodes",
    "mean_predicted_outcomes",
    "mean_excess_outcomes",
    "missing_target_outcome_rate",
    "proposal_probability_concentration",
    "runtime_seconds"
  ],
  "gates": {
    "referenceMinimumTargetNonzeroRetention": 0.75,
    "referenceMinimumTargetCredibleRetention": 0.75,
    "referenceMaximumEmptyPosteriorRate": 0.1,
    "referenceMinimumTransitionSetExact": 0.75,
    "referenceMaximumMeanExcessOutcomes": 0.25,
    "referenceMaximumMissingTargetOutcomeRate": 0.05
  },
  "limits": {
    "newModelForwardPasses": 0,
    "newFeatureExtractions": 0,
    "newLinearFits": 0,
    "hyperparameterSelections": 0,
    "adapterTrainingRuns": 0,
    "probabilisticReplayRuns": 1,
    "finalSuiteConstructions": 0
  }
