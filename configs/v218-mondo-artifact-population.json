  "parserDesign": {
    "oboEncoding": "utf-8",
    "termStanza": "Term",
    "requiredOBOFields": ["id", "name"],
    "textFields": ["name", "def", "synonym"],
    "logicalFields": ["is_a", "relationship", "intersection_of", "equivalent_to", "disjoint_from"],
    "mappingFields": ["xref"],
    "statusFields": ["is_obsolete", "replaced_by", "consider"],
    "stripOBOCommentsAfterBang": true,
    "normalizeWhitespace": true,
    "sortSetValuedFields": true,
    "duplicateTermIdPolicy": "FAIL",
    "remoteImportPolicy": "FORBID_AND_DO_NOT_RESOLVE",
    "assertedStateIsInferredOWLEquivalence": false,
    "tabularControlPolicy": "UTF8_TSV_HEADER_REQUIRED_AND_MONDO_ID_CENSUS",
    "releaseSummaryPolicy": "UTF8_MARKDOWN_FROZEN_HEADING_AND_COUNT_CENSUS"
  },
  "eventDesign": {
    "eligibleEventTypes": [
      "ADDED",
      "REMOVED",
      "NAME_CHANGED",
      "DEFINITION_CHANGED",
      "SYNONYM_CHANGED",
      "LOGICAL_AXIOM_CHANGED",
      "MAPPING_CHANGED",
      "OBSOLETION_CHANGED",
      "REPLACEMENT_CHANGED",
      "OBSOLETION_CANDIDATE_STATUS_CHANGED"
    ],
    "primaryEventPrecedence": [
      "REPLACEMENT_CHANGED",
      "OBSOLETION_CHANGED",
      "OBSOLETION_CANDIDATE_STATUS_CHANGED",
      "ADDED",
      "REMOVED",
      "NAME_CHANGED",
      "DEFINITION_CHANGED",
      "SYNONYM_CHANGED",
      "LOGICAL_AXIOM_CHANGED",
      "MAPPING_CHANGED"
    ],
    "additionDefinition": "term identifier absent from older release and present in newer release",
    "removalDefinition": "term identifier present in older release and absent from newer release",
    "textChangeDefinition": "normalized asserted name, definition, or synonym set differs between releases",
    "assertedLogicalChangeDefinition": "normalized asserted OBO logical-field set differs; no inferred closure",
    "mappingChangeDefinition": "normalized asserted xref set differs",
    "obsoletionDefinition": "asserted is_obsolete value differs",
    "replacementDefinition": "asserted replaced_by or consider set differs",
    "candidateStatusDefinition": "identifier membership differs between the two frozen obsoletion-candidate TSV files"
  },
  "populationDesign": {
    "olderPayloadId": "MONDO_BASE_2026_07_06",
    "newerPayloadId": "MONDO_BASE_2026_08_04",
    "olderCandidatePayloadId": "MONDO_OBSOLETION_CANDIDATES_2026_07_06",
    "newerCandidatePayloadId": "MONDO_OBSOLETION_CANDIDATES_2026_08_04",
    "changedControlPayloadId": "MONDO_DIFF_CHANGED_2026_08_04",
    "newControlPayloadId": "MONDO_DIFF_NEW_2026_08_04",
    "oneFamilyPerUnionOfStableIdReplacementAndConsiderLinks": true,
    "oneRecordPerEvidenceModePerEligibleFamily": true,
    "evidenceModes": ["VERSION_UNSPECIFIED", "CURRENT_RELEASE_DECLARED"],
    "requiredAnyNormalizedSurfaceText": true,
    "surfaceTextPreference": ["older_name", "newer_name", "older_synonym", "newer_synonym"],
    "publicFields": ["surface_text", "release_evidence", "requested_semantic_target", "evidence_mode"],
    "hiddenTruthFields": [
      "source_concept_ids",
      "event_types",
      "primary_event_type",
      "old_state_class_ids",
      "current_state_class_ids",
      "replacement_target_class_ids",
      "candidate_class_ids",
      "equivalence_classes",
      "expressibility_state",
      "evidence_state",
      "boundary_witness",
      "correct_decision",
      "decision_consequence"
    ],
    "redactSourceIdentifiersFromPublicText": true,
    "semanticStateClassDefinition": "sha256_of_normalized_asserted_text_logical_mapping_and_lifecycle_state_or_explicit_ABSENT_state",
    "equivalenceClassDefinition": "exact_identity_of_normalized_asserted_state_signature_not_inferred_OWL_equivalence",
    "versionSpaceDefinition": "all_old_current_and_linked_replacement_state_classes_compatible_with_the_public_surface_and_release_evidence",
    "expressibilityStates": [
      "OLD_AND_CURRENT",
      "NEW_ONLY",
      "OLD_ONLY",
      "CURRENT_OBSOLETE_WITH_REPLACEMENT",
      "CURRENT_OBSOLETE_WITHOUT_REPLACEMENT"
    ],
    "boundaryWitnessDefinition": "lexicographically_first_changed_asserted_field_value_or_presence_state_between_two_candidate_classes",
    "unspecifiedCorrectDecision": "PRESERVE_VERSION_SPACE_OR_CLARIFY",
    "currentLiveCorrectDecision": "RESOLVE_CURRENT_STATE",
    "currentReplacementCorrectDecision": "FOLLOW_ASSERTED_REPLACEMENT",
    "currentAbsentCorrectDecision": "ABSTAIN_NOT_EXPRESSIBLE",
    "decisionConsequenceDefinition": "unit loss for forced singleton or wrong lifecycle action when the frozen candidate states require preservation replacement-following or abstention; zero for the exact oracle decision",
    "excludeUnchangedFamilies": true,
    "excludeFamiliesWithoutSurfaceText": true
  },
  "controlAgreement": {
    "newTermControlMustExactlyMatchParsedAddedIds": true,
    "changedTermControlIdsMustAllBelongToParsedChangedFamilies": true,
    "obsoletionCandidateControlsMustParseAndHaveUniqueIds": true,
    "sourceVersionControlsMustParseWithNonemptyRows": true,
    "releaseSummaryRequiredCategories": ["NEW_TERMS", "RENAMED_TERMS", "TEXT_DEFINITIONS", "OBSOLETIONS_WITH_REPLACEMENT"]
  },
  "splitDesign": {
    "groupKey": "concept_family_id",
    "allRecordsAndLinkedIdentifiersInFamilyRemainTogether": true,
