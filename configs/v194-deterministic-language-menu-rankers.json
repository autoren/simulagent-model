{
  "schemaVersion": "194-deterministic-language-menu-rankers-design",
  "experiment": "v194_fresh_development_deterministic_language_to_menu_ranking_controls",
  "parentV193OutcomeLock": "configs/v193-shadow-menu-interface-frontier-outcome-lock.json",
  "sourceV192OutcomeLock": "configs/v192-fresh-language-to-menu-extraction-outcome-lock.json",
  "developmentLanguage": "outputs/v192-fresh-language-to-menu-extraction/extraction/development-language.json",
  "hiddenTargets": "outputs/v191-fresh-language-to-menu-population/population/hidden-targets.json",
  "visibleMenu": "outputs/v193-shadow-menu-interface-frontier/interface/visible-menu.json",
  "hiddenOptionMap": "outputs/v193-shadow-menu-interface-frontier/interface/hidden-option-map.json",
  "primaryPrior": "outputs/v193-shadow-menu-interface-frontier/interface/primary-prior.json",
  "fixedHierarchyTargetCosts": "outputs/v193-shadow-menu-interface-frontier/interface/fixed-hierarchy-target-costs.json",
  "claimBoundary": "fresh-development deterministic character/token menu-ranking controls under the frozen V193 trusted-answer controller; not model performance, unrestricted open-world recognition, protected confirmation, human reliability, ontology truth, authority, action, or execution",
  "observableQuery": {
    "lastUser": "exact final USER utterance in the frozen conversation prefix",
    "allUser": "all USER utterances in order joined by one space",
    "systemUtterancesExcluded": true,
    "missingObservationProducesInsufficient": true,
    "goldTargetsSourceMetadataTruthKindsAndHiddenMapExcludedFromRanking": true
  },
  "normalization": {
    "unicode": "NFKC",
    "case": "casefold",
    "characterView": "retain alphanumeric characters only then raw 3/4/5-gram counts",
    "tokenView": "alphanumeric whitespace tokens; menu intent_concept remains one token",
    "similarity": "cosine over raw counts",
    "tieBreak": "ascending option_id"
  },
  "rankers": [
    {"ranker_id": "CHAR_LAST", "query": "lastUser", "view": "character"},
    {"ranker_id": "CHAR_ALL", "query": "allUser", "view": "character"},
    {"ranker_id": "TOKEN_ALL", "query": "allUser", "view": "token"},
    {"ranker_id": "RRF_ALL", "query": "allUser", "view": "reciprocal_rank_fusion_CHAR_ALL_TOKEN_ALL", "rrfConstant": 60}
  ],
  "evaluation": {
    "rankedOutputLength": 3,
    "policies": ["TOP1_PLUS_OTHER", "TOP3_PLUS_OTHER"],
    "top1QuestionCost": 0.10,
    "top3QuestionCost": 0.20,
    "missThenGenericAdditionalCost": 0.40,
    "insufficientUsesFrozenTargetSpecificHierarchyCost": true,
    "primaryWeights": "frozen V193 prior divided equally across the six V191 records for each contract",
    "balancedMacroWeights": "equal across 84 observed records",
    "championRule": "minimum primary top3 mean cost, then primary top1 mean cost, then macro top3 mean cost, then ranker_id",
    "randomTop1RecallControl": 0.07142857142857142,
    "randomTop3RecallControl": 0.21428571428571427,
    "materialPrimaryMeanCost": 0.36
  },
  "evaluationGates": {
    "requiredFixtureCount": 98,
    "requiredObservedCount": 84,
    "requiredMissingCount": 14,
    "requiredRankerCount": 4,
    "requiredObservedRecordsPerContract": 6,
    "requiredStructuredRankingRate": 1.0,
    "requiredMissingInsufficientRate": 1.0,
    "requiredTargetRetentionRate": 1.0,
    "requiredFinalExactnessAfterTrustedAnswers": 1.0,
    "minimumBestPrimaryTop3RecallForSignal": 0.30,
    "minimumBestMacroTop3RecallForSignal": 0.30,
    "requiredFixedHierarchyPrimaryMeanCost": 0.38,
    "requiredAlwaysGenericPrimaryMeanCost": 0.40,
    "requiredOracleTop1PrimaryMeanCost": 0.10,
    "requiredOracleTop3PrimaryMeanCost": 0.20,
    "maximumManualLanguageInspectionCount": 0,
    "maximumProtectedLanguageReadCount": 0,
    "maximumModelLoadCount": 0,
    "maximumModelGenerationCount": 0,
    "maximumAPICallCount": 0,
    "maximumTrainingRunCount": 0,
    "maximumOntologyRegistrationCount": 0,
    "maximumTrustedStateMutationCount": 0,
    "maximumServiceCallCount": 0,
    "maximumExternalSideEffectCount": 0,
    "maximumActualExecutionCount": 0
  },
  "preLockExposure": {
    "developmentLanguageReadCount": 0,
    "deterministicLanguageScoreCount": 0,
    "manualLanguageInspectionCount": 0,
    "protectedLanguageReadCount": 0,
    "modelLoadCount": 0,
    "modelGenerationCount": 0,
    "APICallCount": 0,
    "trainingRunCount": 0,
    "actualExecutionCount": 0
  },
  "decisionRule": {
    "ifEveryIntegritySafetyAndMinimumSignalGatePasses": "freeze_V194_controls_and_authorize_one_separately_preregistered_bounded_local_model_shadow_comparator",
    "otherwise": "freeze_V194_negative_without_model_or_protected_access",
    "deterministicMaterialValueIsReportedNotRequiredForModelAuthorization": true,
    "passAuthorizesImmediateModelRun": false,
    "passAuthorizesAPIFallback": false,
    "passAuthorizesProtectedAccessRegistrationAuthorityActionOrExecution": false
  }
}
