{
  "schemaVersion": "74-active-sensing-structural-design",
  "economicLock": "configs/v74-active-sensing-economic-lock.json",
  "horizonActions": 3,
  "tieTolerance": 1e-12,
  "structuralGates": {
    "requiredStructuralUnitTests": 10,
    "maximumStates": 2,
    "maximumActions": 4,
    "maximumObservations": 3,
    "maximumDenseKernelBytes": 4096,
    "maximumExactBellmanNodeUpperBound": 100,
    "requiredInitialBestUnconditionedAction": "calibrate_beacon",
    "maximumInitialBestUnconditionedExpectedReward": -0.5,
    "requiredCalibrationBeaconHarvestable": false,
    "requiredCalibrationTargetTransition": "source_listen_transition",
    "requiredPointModelSupportIdentity": true,
    "minimumCalibrationMutualInformationNats": 0.6,
    "minimumTargetListenTotalVariation": 0.95,
    "minimumPairedDecisionCorrectProbability": 0.98,
    "minimumFixedAdaptivePolicyOverBestOpenLoopRawAdvantage": 5.0,
    "minimumFixedAdaptivePolicyOverBestOpenLoopNormalizedAdvantage": 0.015,
    "minimumNormalizedMarginAboveEconomicThreshold": 0.005,
    "maximumExactBayesAdaptiveCalls": 0,
    "maximumMAPCalls": 0,
    "maximumPosteriorSamplingCalls": 0,
    "maximumMyopicCalls": 0,
    "maximumProtectedSourceAccessCount": 0
  },
  "fixedStructuralPolicy": {
    "action0": "calibrate_beacon",
    "action1AfterEitherBeaconLabel": "listen_target",
    "action2IfLabelsMatch": "open_right",
    "action2IfLabelsDiffer": "open_left"
  },
  "decisionRule": {
    "ifEveryGatePasses": "freeze the adapter structural pass and authorize locking of the already preregistered evaluator",
    "ifAnyGateFails": "freeze a negative V74 structural result and stop before exact Bayes-adaptive, MAP, posterior-sampling, or myopic outcomes",
    "noRetrospectiveChanges": true
  }
}
