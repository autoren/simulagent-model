    "requiredPartialWriteRecovery": 1.0,
    "requiredRepeatedRollbackIdempotence": 1.0,
    "requiredProvenanceRestartValidity": 1.0,
    "requiredProvenanceTamperDetection": 1.0,
    "requiredAtomicMultiEntityRetention": 1.0,
    "requiredPostRecoveryContinuation": 1.0,
    "requiredInvariantPreservation": 1.0,
    "requiredZeroUnauthorizedRetainedMutation": 1.0,
    "maximumEvaluationRecordCount": 0,
    "maximumManualJudgmentCount": 0,
    "maximumModelLoadCount": 0,
    "maximumModelGenerationCount": 0,
    "maximumAPICallCount": 0,
    "maximumTrainingRunCount": 0,
    "maximumProvisionalOntologyUseCount": 0,
    "maximumRealServiceCallCount": 0,
    "maximumExternalSideEffectCount": 0,
    "maximumRealExecutionCount": 0
