{
  "schemaVersion": "171-stateful-sandbox-sequence-confirmation-design",
  "experiment": "v171_unchanged_V168_contract_on_fresh_stateful_transaction_sequences",
  "parentV170OutcomeLock": "configs/v170-unchanged-planner-fresh-confirmation-outcome-lock.json",
  "sourceV168OutcomeLock": "configs/v168-fixed-ontology-reversible-sandbox-outcome-lock.json",
  "claimBoundary": "project-authored exhaustive bounded stateful simulation confirmation only; not language understanding, provisional ontology integration, persistent-database validation, concurrency proof, deployment, real service control, or real execution",
  "fixedSourceContract": {
    "reuseV168FixedOntologyExactly": true,
    "reuseV168InvariantsExactly": true,
    "reuseV168ProposalValidationExactly": true,
    "reuseV168AtomicPatchAndRevisionSemanticsExactly": true,
    "reuseV168PreviewBindingAndVerificationSemanticsExactly": true,
    "modifyV168SourceOrLockedArtifacts": false,
    "addedHarnessScopeOnly": [
      "durable transaction lifecycle status",
      "write-ahead recovery journal",
      "simulated restart and crash recovery",
      "idempotent replay and repeated rollback guards",
      "provenance verification before recovery or continuation"
    ]
  },
  "population": {
    "split": "fresh_procedural_confirmation",
    "enumeration": "complete Cartesian product of every scenario family and variant index",
    "variantIndices": [200, 201, 202, 203, 204, 205, 206, 207, 208, 209, 210, 211],
    "scenarioFamilies": [
      "revision_race",
      "committed_replay_across_restart",
      "crash_after_preview",
      "crash_after_snapshot_before_apply",
      "crash_after_apply_before_verify",
      "crash_after_verify_before_finalize",
      "partial_multi_entity_write",
      "repeated_rollback_across_restart",
      "provenance_multi_restart",
      "provenance_tamper_detection",
      "atomic_multi_entity_retained"
    ],
    "requiredSequenceCount": 132,
    "requiredScenarioCount": 11,
    "requiredSequencesPerScenario": 12,
    "selectionOrExclusionAfterOutcomeInspectionAllowed": false,
    "projectAuthoredSynthetic": true,
    "humanAuthored": false,
    "modelGenerated": false
  },
  "recoveryPolicy": {
    "unverifiedPreparedOrAppliedTransaction": "restore complete before-state snapshot and mark recovered_rollback",
    "verifiedTransactionWhoseStateMatchesExpectedPostState": "finalize retained after restart",
    "provenanceFailure": "fail closed before recovery or continuation without mutation",
    "terminalTransactionReplay": "reject idempotently without mutation",
    "repeatedRollback": "return already_rolled_back without restoring an old snapshot or mutating state",
    "postRecoveryContinuationRequired": true
  },
  "registeredMetrics": [
    "exact oracle final state",
    "exact expected disposition",
    "serializable retained and recovered boundaries",
    "revision race rejection",
    "committed replay idempotence",
    "crash-point recovery",
    "partial-write recovery",
    "repeated rollback idempotence",
    "provenance validity across restart",
    "provenance tamper detection",
    "atomic multi-entity retention",
    "post-recovery continuation",
    "invariant preservation at every externally visible boundary",
    "zero unauthorized retained mutation",
    "model and real-execution access"
  ],
  "confirmationGates": {
    "requiredSequenceCount": 132,
    "requiredScenarioCount": 11,
    "requiredSequencesPerScenario": 12,
    "requiredExpectedDispositionAccuracy": 1.0,
    "requiredExactOracleFinalState": 1.0,
