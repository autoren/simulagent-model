    "realServiceCallCount": 0,
    "externalSideEffectCount": 0,
    "realExecutionCount": 0
  },
  "authorityBoundary": {
    "stateAndDurabilityAreLocalInMemorySimulation": true,
    "onlyFixedTrustedV168OntologyMayBeUsed": true,
    "provisionalConceptsMayNotEnterSandbox": true,
    "learnedConfidenceCannotAuthorizeCommit": true,
    "provenanceVerifierCannotBeBypassed": true,
    "realServiceOrToolTargetExists": false,
    "realExecutionCount": 0
  },
  "decisionRule": {
    "ifEveryConfirmationGatePasses": "freeze_V171_as_positive_fresh_stateful_sandbox_confirmation",
    "otherwise": "freeze_V171_boundary_result_and_stop_before_cross_track_integration",
    "passAuthorizesTrustedOnlyShadowIntegrationDesign": true,
