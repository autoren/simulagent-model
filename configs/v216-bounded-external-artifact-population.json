  "retrievalContract": {
    "exactlyOneAttemptPerPayload": true,
    "maximumPayloadCount": 3,
    "maximumTotalPayloadBytes": 28000000,
    "requireExactExpectedByteCount": true,
    "sha256EveryRawPayloadBeforeParsing": true,
    "requireDeclaredSha256WhenPresent": true,
