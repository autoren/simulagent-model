  "parserDesign": {
    "oboEncoding": "utf-8",
    "termStanza": "Term",
    "requiredOBOFields": ["id", "name"],
    "textFields": ["name", "def", "synonym"],
    "logicalFields": ["is_a", "relationship", "intersection_of", "equivalent_to", "disjoint_from"],
    "statusFields": ["is_obsolete", "replaced_by", "consider"],
    "stripOBOCommentsAfterBang": true,
    "normalizeWhitespace": true,
    "sortSetValuedFields": true,
    "w3cControlParser": "python_xml_etree_RDF_XML_well_formedness_and_test_subject_census",
    "w3cControlIsReasonerEvidence": false,
    "assertedAxiomSignatureIsInferredSemanticEquivalence": false
  },
  "populationDesign": {
    "olderPayloadId": "UBERON_BASIC_2025_05_28",
    "newerPayloadId": "UBERON_BASIC_2025_08_15",
    "oneRecordPerEligibleCurrentTerm": true,
    "requiredCurrentName": true,
    "requiredCurrentDefinition": true,
    "requiredCurrentAssertedLogicalAxiom": true,
    "eligibleChangeTypes": ["ADDED", "NAME_CHANGED", "DEFINITION_CHANGED", "SYNONYM_CHANGED", "LOGICAL_AXIOM_CHANGED", "OBSOLETION_CHANGED", "REPLACEMENT_CHANGED"],
    "primaryChangePrecedence": ["ADDED", "OBSOLETION_CHANGED", "REPLACEMENT_CHANGED", "LOGICAL_AXIOM_CHANGED", "DEFINITION_CHANGED", "NAME_CHANGED", "SYNONYM_CHANGED"],
    "publicObservationFields": ["prior_name", "prior_definition", "prior_synonyms", "current_name", "current_definition", "current_synonyms"],
    "hiddenTruthFields": ["source_term_id", "change_types", "primary_change_type", "prior_asserted_axioms", "current_asserted_axioms", "added_axioms", "removed_axioms", "oracle_class_id", "candidate_class_ids", "evidence_status"],
    "redactSourceIdentifiersFromPublicText": true,
    "oracleClassDefinition": "sha256_of_sorted_current_asserted_axiom_signature",
    "observationEquivalenceDefinition": "sha256_of_normalized_public_observation",
    "versionSpaceDefinition": "all_oracle_classes_sharing_the_same_normalized_public_observation",
    "boundaryWitnessDefinition": "lexicographically_first_asserted_axiom_in_the_symmetric_difference_of_two_classes",
    "excludeRemovedTermsWithoutCurrentText": true,
    "excludeUnchangedTerms": true,
    "excludeTermsMissingRequiredTextOrLogicalFields": true
  },
  "splitDesign": {
    "groupKey": "normalized_public_observation_hash",
    "allRecordsWithSameObservationRemainTogether": true,
    "developmentFractionTarget": 0.75,
    "assignment": "within_primary_change_stratum_sha256_rank_with_every_fourth_group_protected",
    "minimumDevelopmentGroups": 16,
    "minimumProtectedGroups": 8,
    "protectedDownstreamMethodEvaluationCount": 0,
    "protectedManualSemanticInspectionCount": 0
