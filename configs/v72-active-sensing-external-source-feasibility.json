{
  "schemaVersion": "72-active-sensing-external-source-feasibility",
  "experiment": "v72_metadata_only_external_active_sensing_discovery",
  "authorizationSource": "configs/v72-active-sensing-oracle-outcome-lock.json",
  "preInventoryDisclosure": {
    "publicRepositoryLandingPagesPreviewed": [
      "https://github.com/sisl/SBO_AIPPMS",
      "https://github.com/AdaCompNUS/sarsop",
      "https://github.com/sisl/BetaZero.jl"
    ],
    "previewPurpose": "general lead discovery before source-tree inspection",
    "modelFilesRead": 0,
    "candidatePoliciesRead": 0,
    "candidatePolicyValuesComputed": 0,
    "candidateOptimalActionsComputed": 0,
    "candidateRegretsComputed": 0,
    "candidateEIGComputed": 0,
    "treatment": "all previewed repositories are exposed development leads and cannot supply protected confirmation evidence"
  },
  "metadataFields": [
    "repository URL",
    "pinned commit",
    "license file and SPDX-compatible classification",
    "model or environment paths",
    "declared state action observation and reward interfaces",
    "presence of distinct sensing and control actions",
    "observation dependence on state and sensing action",
    "delayed state-dependent control consequence",
    "finite exact export availability",
    "source-family overlap and prior exposure"
  ],
  "noncompensatoryStructuralGates": {
    "pinnedSourceAndLicense": true,
    "freshModelFilesRelativeToV62ThroughV71": true,
    "distinctSensingAndControlActions": true,
    "actionDependentObservationChannel": true,
    "delayedStateDependentControlReward": true,
    "atLeastTwoHiddenStatesRequireDifferentControlActions": true,
    "finiteExactRepresentationOrDeterministicFiniteExporter": true,
    "noPolicyValueActionRegretOrEIGUsedForSelection": true
  },
  "partitionRule": {
    "exposedRepositories": "development-only",
    "protectedConfirmation": "must come from a later fresh repository or prospectively sealed untouched model files not named or inspected during development",
    "selectionInputs": "structural metadata only",
    "selectionOutputs": "eligible, development-only, deferred, or excluded with fixed reason codes"
  },
  "selectedDevelopmentBlueprint": {
    "repository": "https://github.com/JuliaPOMDP/RockSample.jl",
    "repositoryRole": "development-only",
    "sourceModel": "RockSamplePOMDP",
    "mapSize": [2, 2],
    "rocksInOrder": [
      {"role": "known_good_reference", "position": [1, 1]},
      {"role": "unknown_target", "position": [2, 2]}
    ],
    "initialPosition": [2, 1],
    "initialBelief": {
      "referenceGoodProbability": 1.0,
      "targetGoodProbability": 0.5
    },
    "sourceParameters": {
      "sensorEfficiency": 1.0,
      "goodRockReward": 10.0,
      "badRockPenalty": -10.0,
      "exitReward": 5.0,
      "stepPenalty": 0.0,
      "sensorUsePenalty": -0.5,
      "discount": 0.95
    },
    "sensorCodebookWrapper": {
      "latentCodebooks": ["canonical", "reversed"],
      "latentPrior": [0.5, 0.5],
      "swapOnlyGoodBadLabelsForCheckActions": true,
      "preserveNoneForMovementSamplingAndExit": true,
      "observationNoiseFloorMixtureWeight": 0.2,
      "purposeOfNoiseFloor": "retain identical full support even when source accuracy reaches one at zero distance"
    },
    "planningHorizonActions": 4,
    "structuralSequence": [
      "check known-good reference to learn the codebook",
      "check unknown target to learn its condition",
      "move north to the target",
      "sample a good target or exit east instead of sampling a bad target"
    ],
    "expectedFiniteDimensionsBeforeLatentAugmentation": {
      "states": 17,
      "actions": 7,
      "observations": 3
    },
    "outcomeClaims": "none; this blueprint is selected by source structure only"
  },
  "reasonCodes": [
    "eligible_active_sensing_structure",
    "no_distinct_sensing_action",
    "no_delayed_state_dependent_control_reward",
    "no_finite_exact_representation",
    "license_unresolved",
    "prior_family_overlap",
    "development_exposed",
    "resource_deferred"
  ],
  "firewall": {
    "computeCandidatePolicyValues": false,
    "computeCandidateOptimalActions": false,
    "computeCandidateRegrets": false,
    "computeCandidateEIG": false,
    "runCandidateSimulator": false,
    "readV71ProtectedModels": false,
    "humanData": false,
    "modelAccess": false,
    "adapterTraining": false
  },
  "stageAuthorization": {
    "inspectAndPinSourceMetadata": true,
    "writeAndAuditSourceInventory": true,
    "selectDevelopmentModelsByStructuralMetadata": true,
    "selectProtectedConfirmationModels": false,
    "implementCandidateEvaluator": false,
    "computeCandidateOutcomes": false
  }
}
