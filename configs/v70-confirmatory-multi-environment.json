  "unknownDynamicsFamily": {
    "inheritExactlyFrom": "V69",
    "identityNames": [
      "dominant_forward_cycle_remapping",
      "dominant_backward_cycle_remapping"
    ],
    "identityPrior": [0.5, 0.5],
    "thetaSupport": [0.6, 0.95],
    "thetaPrior": "scaled_beta_2_2",
    "transitionDefinition": "T_identity_theta(command)=theta*T_source(cycle_remapped_command_for_identity)+(1-theta)*T_source(command)",
    "observationAndReward": "unchanged_pinned_source_arrays"
  },
  "publicPrefixCensus": {
    "depths": [0, 1],
    "retainEveryReachableActionObservationHistory": true,
    "minimumProbabilityThreshold": 0.0,
    "deduplication": false,
    "selectionOrRejection": false,
    "truthFields": false,
    "resourceRule": "estimate_complete_census_and_exact_operation_bounds_before_constructing_or_scoring_but_do_not_drop_any_model"
  },
  "exactPlanning": {
    "horizonActions": 3,
    "primaryQuadratureNodes": 65,
    "convergenceQuadratureNodes": 129,
    "tieTolerance": 1e-12,
    "tieBreak": "first_action_in_the_frozen_per_model_canonical_cycle"
  },
  "controls": {
    "inheritExactlyFrom": "V69",
    "pointModelOffSupportRule": "after_an_exact_zero_point_model_observation_repeat_the_first_frozen_canonical_action_for_all_remaining_actions"
  },
  "normalization": {
    "returnScale": "max(1,(maximum_source_reward-minimum_source_reward)*sum_discount_powers_zero_through_two)",
    "normalizedRegret": "(exact_Bayes_adaptive_value-control_value)/returnScale",
    "materialNormalizedRegret": 0.005
  },
  "confirmatoryGates": {
    "minimumConfirmatoryModels": 9,
    "minimumStructurallyRelatedModels": 3,
    "minimumNovelModels": 6,
    "minimumCompletedRecordFraction": 1.0,
    "minimumSourceValidationRate": 1.0,
    "minimumBeliefNormalizationRate": 1.0,
    "minimumFiniteMetricRate": 1.0,
    "maximumPrimaryVsConvergenceNormalizedValueError": 1e-8,
    "minimumPrimaryActionInConvergenceOptimalSetRate": 1.0,
    "minimumModelsWithExactBAMAPRootActionDisagreement": 3,
    "minimumStructurallyRelatedModelsWithExactBAMAPRootActionDisagreement": 1,
    "minimumNovelModelsWithExactBAMAPRootActionDisagreement": 2,
    "minimumModelsWithMaterialMAPRegret": 3,
    "minimumStructurallyRelatedModelsWithMaterialMAPRegret": 1,
    "minimumNovelModelsWithMaterialMAPRegret": 2,
    "minimumModelsWithMaterialPosteriorSamplingRegret": 2,
    "minimumMaximumNormalizedMAPRegret": 0.01,
    "maximumRecordSelectionOrRejectionCount": 0,
    "maximumDevelopmentModelsRescored": 0,
    "maximumHumanRecordAccessCount": 0,
    "maximumModelForwardPassCount": 0,
    "maximumAdapterTrainingRunCount": 0
