  "analysisHierarchy": [
    "primary_replication_is_model_level_across_all_nine_Tier_A_confirmatory_environments",
    "record_level_counts_and_effect_distributions_are_secondary_and_cannot_compensate_for_failed_model_level_gates",
    "structurally_related_and_novel_strata_must_each_pass_their_frozen_subgates",
    "the_cheese_terminating_nonterminating_pair_is_reported_as_a_separate_Tier_B_stress_comparison_without_pooling_into_an_external_uncertainty_claim",
    "no_gate_or_threshold_changes_after_any_confirmatory_value_is_computed"
  ],
  "decisionHierarchy": [
    "if_every_confirmatory_gate_passes_claim_multi_environment_replication_for_the_project_authored_V69_family_within_the_pinned_source_suite",
    "if_any_gate_fails_report_the_complete_negative_or_mixed_confirmatory_result_without_model_dropping_or_gate_revision",
    "Tier_B_pair_results_never_override_the_Tier_A_primary_decision"
  ],
  "claimBoundary": {
