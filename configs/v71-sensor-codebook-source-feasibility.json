      "posterior_sampling_point_model",
      "open_loop_sequence",
      "myopic_one_step"
    ],
    "pointModelFallback": "forbidden; identical point-model support must make every retained history on-support",
    "tieTolerance": 1e-12,
    "tieBreak": "first action in pinned source-file order",
    "returnScale": "max(1,(maximum_source_reward-minimum_source_reward)*sum_discount_powers_zero_through_two)",
    "normalizedRegret": "(exact_Bayes_adaptive_value-control_value)/returnScale",
