  "unknownSensorFamily": {
    "latentNames": ["canonical_dominant", "reversed_dominant"],
    "latentPrior": [0.5, 0.5],
    "reliability": 0.85,
    "reverseIndex": "reverse(j)=observation_count-1-j in pinned source-file order",
    "canonicalDominant": "O_z(j|a,s')=rho*O_source(j|a,s')+(1-rho)*O_source(reverse(j)|a,s')",
    "reversedDominant": "O_z(j|a,s')=rho*O_source(reverse(j)|a,s')+(1-rho)*O_source(j|a,s')",
    "transitions": "unchanged pinned source transition arrays for both latent values",
    "rewards": "source observation-conditioned immediate values are collapsed exactly under O_source before the delivered-label transformation; all other rewards are unchanged",
    "supportRule": "both point models must have identical delivered-observation support for every action and successor state; any violation is a hard design failure"
  },
  "prospectiveDevelopmentDesign": {
    "publicPrefixDepths": [0, 1],
    "retainEveryReachableActionObservationHistory": true,
