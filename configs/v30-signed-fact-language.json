  "ontology": {
    "entityTypes": ["unit", "hub"],
    "unaryPredicates": [
      {"id": "stable", "entityType": "unit", "trueForm": "{entity} is stable", "falseForm": "{entity} is unstable"},
      {"id": "charged", "entityType": "unit", "trueForm": "{entity} is charged", "falseForm": "{entity} is uncharged"},
      {"id": "online", "entityType": "hub", "trueForm": "{entity} is online", "falseForm": "{entity} is offline"}
    ],
    "relations": [
      {"id": "linked", "sourceType": "unit", "targetType": "unit", "directTrueForm": "{source} is linked to {target}", "directFalseForm": "{source} is not linked to {target}", "inverseTrueForm": "{target} receives a link from {source}", "inverseFalseForm": "{target} does not receive a link from {source}"},
      {"id": "feeds", "sourceType": "hub", "targetType": "unit", "directTrueForm": "{source} feeds {target}", "directFalseForm": "{source} does not feed {target}", "inverseTrueForm": "{target} is fed by {source}", "inverseFalseForm": "{target} is not fed by {source}"}
    ],
    "truthStatuses": ["true", "false", "unknown"]
  },
  "semanticOperators": [
    "affirmative_gold",
    "negated_opposite",
    "contrastive_both",
    "double_negation",
    "explicit_unknown"
  ],
  "splits": {
    "language_fit": {"surfaceFamiliesPerOperator": ["fit_a", "fit_b", "fit_c"]},
    "language_calibration": {"surfaceFamiliesPerOperator": ["cal_a"]},
    "language_evaluation": {"surfaceFamiliesPerOperator": ["eval_a", "eval_b", "eval_c"]}
  },
  "construction": {
    "baseScenesPerSurfaceFamily": 2,
    "entityCounts": [3, 4, 5],
    "sceneVariants": [
      "direct_clean",
      "inverse_clean",
      "direct_distractor",
      "reversed_link_arguments_clean"
    ],
    "factsInDirectScenes": ["stable", "charged", "online", "linked", "feeds"],
    "factsInInverseScenes": ["linked", "feeds"],
    "factsInReversedScenes": ["linked"]
  },
  "model": {
    "model": "mlx-community/Qwen3.5-4B-4bit",
