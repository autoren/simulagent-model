    "hiddenSize": 2560,
    "maxSequenceLength": 768,
    "primarySystemPrompt": "Normalize the evidence into one fact from the declared typed ontology. Resolve lexical opposites, negation scope, double negation, inverse relational wording, uncertainty, and irrelevant distractors. Return only the requested option letter.",
    "v26SystemPrompt": "Classify the evidence relative to the candidate fact using the registered letter code.",
    "nliSystemPrompt": "Determine the epistemic truth status of the candidate atom from the evidence. Resolve opposites, scoped negation, double negation, inverse relations, and explicit uncertainty. Return only A, B, or C."
  },
  "methods": {
    "primary": {
      "name": "candidate_independent_constrained_signed_fact",
