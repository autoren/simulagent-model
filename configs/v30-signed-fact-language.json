      "argument2NotApplicableValue": "N/A",
      "candidateFactsVisible": false,
      "fieldDecision": "float32_direct_label_logit_argmax_fixed_order",
      "candidateAlignment": "deterministic_maximum_weight_one_to_one_from_field_log_probabilities"
    },
    "v26Baseline": {
      "name": "locked_v26_direct_abc_oracle_atom_baseline",
      "truthLabels": [
