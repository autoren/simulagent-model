  },
  "decisionRule": {
    "ifEveryBaselineGatePassesAndResidualIsZero": "freeze_V166_and_advance_to_evidence_gathering_and_fixed_ontology_reversible_sandbox_design_without_LLM_residual",
    "ifPipelinePassesButResidualIsNonzero": "freeze_V166_and_preregister_residual_qualification_before_any_model",
