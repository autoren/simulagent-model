  "methods": {
    "ordered": ["EXACT_STRUCTURAL_CEILING", "NORMALIZED_EXACT_RETRIEVAL_K8", "TYPED_APPROX_RETRIEVAL_K8", "BOUNDED_L0_LPLUS_SYNTHESIS", "FULL_CONSTRAINT_PROPAGATION", "DETERMINISTIC_STACK"],
    "EXACT_STRUCTURAL_CEILING": {"role": "oracle_aligned_ceiling", "behaviorDomainSize": 256},
    "NORMALIZED_EXACT_RETRIEVAL_K8": {"candidateBudget": 8, "excludeEvaluationGroupAndAllVariants": true, "canonicalizeIdentityCommutativityEvidenceOrderAndArbitraryNames": true, "tieBreak": "fit_group_hash_then_behavior_id"},
    "TYPED_APPROX_RETRIEVAL_K8": {"candidateBudget": 8, "nearestFitGroupCount": 4, "distance": "one_minus_typed_feature_jaccard", "tieBreak": "distance_then_fit_group_id_then_behavior_id"},
    "BOUNDED_L0_LPLUS_SYNTHESIS": {"representedBehaviorBudget": 15, "detectDirectExpressionAndReferenceContradictions": true, "noProposalDistinctFromContradiction": true},
    "FULL_CONSTRAINT_PROPAGATION": {"behaviorDomainSize": 256, "enumerateEveryEquivalenceClass": true},
    "DETERMINISTIC_STACK": {"useTypedParsingThenBoundedSynthesisThenFullConstraintFallback": true, "outsideAndContradictionHandledBeforeSemanticCommitment": true}
  },
  "statusContract": {
    "proposalStatuses": ["SUFFICIENT", "AMBIGUOUS", "CONTRADICTORY", "NO_PROPOSAL", "OUTSIDE_INTERFACE"],
    "noProposalAction": "DEFER_ADJUDICATE",
    "outsideAction": "DEFER_OUTSIDE",
    "candidateIdsAreBehavioralEquivalenceClasses": true,
    "outsideInterfaceSentinelDoesNotConsumeCandidateBudget": true
  },
  "decisionScoring": {
    "correctDiagnosisReward": 10.0,
    "wrongDiagnosisReward": -30.0,
    "boundaryRequestCost": -1.0,
    "safeDeferralReward": -2.0,
    "outsideBoundaryRequestReward": -3.0,
    "normalizationRange": 40.0
