  "authorityBoundary": {
    "populationContainsOnlyShadowVersionSpacesAndTargetIdentities": true,
    "authoritativeOntologyAndStateImmutable": true,
    "plannerNotRun": true,
    "sandboxNotRun": true,
    "modelNotRun": true,
    "provisionalRegistrationAllowed": false,
    "actionOrExecutionAllowed": false,
    "realExecutionCount": 0
  },
  "decisionRule": {
    "ifEveryPopulationGatePasses": "freeze_V172_and_preregister_trusted_only_shadow_integration_on_all_eligible_states_and_targets",
    "otherwise": "freeze_V172_boundary_result_without_integration_scoring",
    "passAuthorizesImmediateIntegrationRun": false,
    "passAuthorizesPolicyTuning": false,
    "passAuthorizesModelRegistrationAuthorityActionOrExecution": false
  }
