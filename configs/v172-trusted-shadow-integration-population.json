    "targetSelectionOrSubsampling": false,
    "targetWeights": "V167 class-balanced prior: one third per class then uniform within class",
    "targetWeightsUsePolicyOutcomes": false,
    "targetIdentitiesFrozenBeforeIntegrationScoring": true
  },
  "populationGates": {
    "requiredSourceStateCount": 448,
    "requiredSelectedStateCount": 448,
    "requiredCandidatesPerState": 32,
    "requiredEligibleStateCount": 132,
    "requiredIneligibleStateCount": 316,
    "requiredTargetCaseCount": 4224,
    "requiredConstraintSignatureUniqueness": 1.0,
    "requiredVersionSpaceExactness": 1.0,
    "requiredTargetMembershipExactness": 1.0,
    "requiredPriorWeightNormalization": 1.0,
    "maximumPlannerPolicyScoreCount": 0,
    "maximumSandboxTransactionCount": 0,
    "maximumEvaluationRecordCount": 0,
    "maximumManualJudgmentCount": 0,
    "maximumModelLoadCount": 0,
    "maximumModelGenerationCount": 0,
    "maximumAPICallCount": 0,
    "maximumTrainingRunCount": 0,
    "maximumOntologyRegistrationCount": 0,
    "maximumTrustedStateMutationCount": 0,
    "maximumRealServiceCallCount": 0,
    "maximumExternalSideEffectCount": 0,
    "maximumActualExecutionCount": 0
  },
  "preLockExposure": {
    "implementationPopulationBuildCount": 1,
    "formalPopulationBuildCount": 0,
    "plannerPolicyScoreCount": 0,
    "sandboxTransactionCount": 0,
    "aggregateIntegrationMetricInspectionCount": 0,
    "evaluationRecordCount": 0,
    "manualJudgmentCount": 0,
    "modelLoadCount": 0,
    "modelGenerationCount": 0,
    "APICallCount": 0,
    "trainingRunCount": 0,
    "ontologyRegistrationCount": 0,
    "trustedStateMutationCount": 0,
