{
  "schemaVersion": "172-trusted-shadow-integration-population-design",
  "experiment": "v172_complete_three_constraint_truth_table_population_before_trusted_shadow_integration",
  "parentV171OutcomeLock": "configs/v171-stateful-sandbox-sequence-confirmation-outcome-lock.json",
  "sourceV170OutcomeLock": "configs/v170-unchanged-planner-fresh-confirmation-outcome-lock.json",
  "roadmap": "docs/research-roadmap-after-v171.md",
  "claimBoundary": "procedurally generated finite-DSL integration population only; not policy performance, transaction performance, language understanding, ontology registration, authority, action, or execution",
  "generator": {
    "candidateTruthTableCount": 256,
