    "modelLoadCount": 0,
    "modelGenerationCount": 0,
    "LLMAPICallCount": 0,
    "adapterTrainingRunCount": 0
  },
  "decisionRule": {
    "ifRepairAuditPasses": "authorize one fresh retrieval of the unchanged pinned archive and run the unchanged V102 scientific gates",
    "ifAnyScientificGateFails": "freeze the negative result without threshold or eligibility changes",
    "ifAnotherTechnicalFailureOccurs": "preserve the verified archive and freeze another technical result before any parser change",
