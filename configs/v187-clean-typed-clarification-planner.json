  "policySemantics": {
    "exactAdaptive": "Bellman minimum over generic clarification and every splitting typed question at each reachable version space; safe deferral is retained but dominated when generic is cheaper",
    "openLoop": "one target-blind fixed question sequence selected before answers; singleton targets stop early, unresolved targets use generic clarification after the sequence",
    "greedy": "at each reachable version space select maximum prior-weighted binary information gain, then ask only when its recursively evaluated cost is strictly below generic clarification",
    "sourceOrder": "use the first frozen partition-distinct question that splits the current version space, with the same four-question budget and generic fallback",
    "oracle": "non-operational target-informed lower bound; choose a one-question singleton certificate when one exists, otherwise minimum clean certificate, then generic if cheaper",
    "missing": "remain INSUFFICIENT at zero cost for every policy"
  },
