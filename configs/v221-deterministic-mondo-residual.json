  "roleSplit": {
    "unit": "group_id",
    "source": "V220_population_manifest_development_group_ids_only",
    "ordering": "sha256_of_V221_ROLE_vertical_bar_group_id_ascending",
    "assignment": "ordered_index_modulo_5_equals_0_is_EVALUATION_else_CALIBRATION",
    "expectedCalibrationGroupCount": 1296,
    "expectedEvaluationGroupCount": 325,
    "groupDisjoint": true,
    "evaluationRecordsMayNotTuneMethodsBudgetsThresholdsOrController": true
  },
  "catalogDesign": {
    "sourcePopulationExperiment": "v220_prospective_fresh_mondo_artifact_population",
    "sources": ["OLDER_OBO", "NEWER_OBO"],
    "surfaceFields": ["name", "synonym"],
    "normalize": "unicode_casefold_then_non_alphanumeric_to_single_space",
    "tokenization": "normalized_whitespace_tokens",
    "characterNgrams": [3, 4, 5],
    "familyDefinition": "union_stable_term_id_asserted_replaced_by_and_consider_links_across_both_releases",
    "stateClassDefinition": "exact_sha256_class_of_V220_normalized_asserted_state_signature",
    "equivalenceCollapse": "exact_state_class_identity",
    "declaredReleaseFilter": "CURRENT_RELEASE_DECLARED_uses_current_or_asserted_replacement_classes_only",
    "unspecifiedVersionSpace": "VERSION_UNSPECIFIED_uses_all_old_current_and_asserted_replacement_classes",
    "remoteImportResolution": false
  },
  "methodPortfolio": [
    {
      "methodId": "M0_NORMALIZED_EXACT",
      "description": "exact normalized surface lookup with exact state-class collapse and no family expansion"
    },
    {
      "methodId": "M1_EXACT_FAMILY",
      "description": "exact normalized lookup followed by atomic stable-ID/replacement/consider family expansion and declared-release filtering"
    },
    {
      "methodId": "M2_HYBRID_RETRIEVAL",
      "description": "M1 plus deterministic token-Jaccard then character-ngram-Dice retrieval with lexicographic ties and atomic family expansion"
    },
    {
      "methodId": "M3_FINAL_FAIL_CLOSED",
      "description": "M2 with exact-family overflow and lifecycle contradiction detection; retrieval-only or conflicting evidence cannot authorize a singleton action"
    }
  ],
  "retrievalScoring": {
    "exactNormalizedScore": 3.0,
    "tokenJaccardWeight": 1.0,
    "characterNgramDiceWeight": 1.0,
    "tieBreak": "score_descending_then_normalized_surface_then_release_then_term_id_then_state_class",
    "exactFamiliesProcessedBeforeRetrievedFamilies": true,
    "familyExpansionIsAtomic": true,
    "partialFamilyInsertionForbidden": true
  },
  "candidateBudgets": [1, 4, 8, 16],
  "primaryAcceptedBudget": 8,
  "controller": {
    "versionUnspecifiedDecision": "PRESERVE_VERSION_SPACE_OR_CLARIFY",
    "noCandidateDecision": "PRESERVE_VERSION_SPACE_OR_CLARIFY",
    "retrievalOnlyDecision": "PRESERVE_VERSION_SPACE_OR_CLARIFY",
    "overflowDecision": "PRESERVE_VERSION_SPACE_OR_CLARIFY",
    "conflictingLifecycleDecision": "PRESERVE_VERSION_SPACE_OR_CLARIFY",
    "authoritativeCurrentDecisionRequiresExactSurfaceFamilyEvidence": true,
    "compatibleLiveDecision": "RESOLVE_CURRENT_STATE",
    "compatibleReplacementDecision": "FOLLOW_ASSERTED_REPLACEMENT",
    "compatibleNotExpressibleDecision": "ABSTAIN_NOT_EXPRESSIBLE",
    "unknownWrongDecisionLoss": 1.0,
    "safeFallbackUsesTruthPreserveLossWhenPresent": true
  },
  "metrics": {
    "requiredByRole": ["CALIBRATION", "EVALUATION"],
    "requiredByMethod": ["M0_NORMALIZED_EXACT", "M1_EXACT_FAMILY", "M2_HYBRID_RETRIEVAL", "M3_FINAL_FAIL_CLOSED"],
    "requiredByBudget": [1, 4, 8, 16],
    "requiredByEvidenceMode": ["VERSION_UNSPECIFIED", "CURRENT_RELEASE_DECLARED"],
    "eventStrata": ["ADDED", "TEXT_CHANGE", "LIFECYCLE_CHANGE", "MAPPING_CHANGED", "LOGICAL_AXIOM_CHANGED", "OTHER"],
    "measures": ["oracle_class_recall", "full_version_space_retention", "candidate_set_size", "singleton_under_ambiguous_truth", "unsafe_singleton_collapse", "exact_decision", "decision_regret"]
  },
  "residualDefinition": {
    "methodId": "M3_FINAL_FAIL_CLOSED",
    "budget": 8,
    "unit": "evaluation_group",
    "groupIsResidualIf": "at_least_one_evaluation_record_has_oracle_class_recall_below_1_after_all_allowed_deterministic_controls",
    "decisionRelevant": "every_missing_frozen_candidate_class_has_a_V220_boundary_witness_or_is_the_only_class_supporting_the_frozen_correct_decision",
    "minimumModelEligibleResidualGroupCount": 12,
    "requiresZeroUnsafeSingletonCollapse": true,
    "requiresFailClosedConflictHandlingAccuracy": 1.0,
    "ifBelowMinimum": "DETERMINISTIC_SUFFICIENT_CLOSE_MODEL_ESCALATION_FOR_RETROSPECTIVE_TASK",
    "ifAtOrAboveMinimumAndSafetyPasses": "MEANINGFUL_DETERMINISTIC_RESIDUAL_ELIGIBLE_FOR_SEPARATE_LOCAL_MODEL_DESIGN"
  },
  "evaluationGates": {
    "requiredDevelopmentGroupAccounting": 1.0,
    "requiredRoleAssignmentAccuracy": 1.0,
    "requiredRoleDisjointness": true,
    "requiredCatalogStateClassAccuracy": 1.0,
    "requiredCandidateClassValidity": 1.0,
    "requiredCandidateBudgetCompliance": 1.0,
    "requiredAtomicFamilyExpansionAccuracy": 1.0,
    "requiredContradictionFailClosedAccuracy": 1.0,
    "maximumUnsafeSingletonCollapseRate": 0.0,
    "maximumPrimaryEvaluationMeanDecisionRegret": 0.1,
    "requiredMetricCellCoverage": 1.0,
    "requiredNoEvaluationTuning": true,
