  "baselines": {
    "tokenization": "casefold_unicode_alphanumeric_tokens",
    "minimumCalibrationTokenCount": 2,
    "RAW_LEXICAL": {
      "fit": "retain tokens seen at least minimum count and with exactly one semantic observation across calibration truth",
      "predict": "emit the unique label among retained tokens in the utterance; otherwise ABSTAIN"
    },
    "COMPOSITIONAL_RESPONSE_SPAN": {
      "fit": "learn context-span tokens as tokens observed under at least two labels within each context; remove them, then retain globally label-pure response tokens at minimum count",
      "predict": "compose a context-specific span remover with the learned response-token map; emit the unique remaining label or ABSTAIN without matching a sentence template"
    },
    "ABSTENTION_FIRST_CONSENSUS": {
      "predict": "accept only identical non-ABSTAIN RAW_LEXICAL and CONTEXT_CONTRAST predictions; otherwise ABSTAIN"
    },
    "ABSTAIN_ALWAYS": {"predict": "ABSTAIN"},
    "predictionInputFields": ["record_id", "context_id", "utterance"],
    "forbiddenPredictionFields": ["group_id", "semantic_regime", "task_state", "semantic_observation_id", "source_probability", "history", "stage", "clarification_action"],
    "evaluationTruthReadDuringFitOrPrediction": false,
    "protectedReadDuringFitPredictionOrScoring": false
  },
  "decisionImpact": {
    "observationUseRule": "a non-ABSTAIN projection selects the frozen V209r1 exact continuation associated with that observation; ABSTAIN selects safe defer",
    "wrongProjectionEvaluation": "evaluate the selected continuation under the posterior induced by the true observation and preceding context history",
    "weighting": "within each evaluation context and counterfactual type, normalize semantic-regime prior times state prior times true source probability over included support records; macro-average context-counterfactual cells",
    "safeDeferralReward": -2.0,
    "returnScale": 120.0,
    "modelScoresOrRanksUsedAsLikelihoods": false
  },
  "artifacts": {
