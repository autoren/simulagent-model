  "parentV216r1OutcomeLock": "configs/v216r1-negative-outcome-verification-repair-outcome-lock.json",
  "roadmap": "docs/research-roadmap-after-v216.md",
  "plan": "docs/v217a-independent-source-event-metadata-census-plan.md",
  "claimBoundary": "official metadata feasibility for at most one fresh independent retrospective artifact source; not payload evidence, a reopened V216 branch, inferred semantic equivalence, correct new-speaker intent, expert validation, model evidence, registration, authority, action, or execution",
  "priorExposure": {
    "candidateFamilyNamesFromRoadmap": ["MONDO", "GENE_ONTOLOGY", "CELL_ONTOLOGY"],
    "blindFamilyDiscoveryClaim": false,
    "sourceSpecificReleaseMetadataReadCount": 0,
    "candidatePayloadBodyByteReadCount": 0,
    "formalSourceAssessmentCount": 0,
    "V216ProtectedReadCount": 0
  },
  "sourceUnits": [
    {
      "unitId": "MONDO",
      "selectionPriority": 1,
      "urls": [
        "https://obofoundry.org/ontology/mondo.html",
        "https://api.github.com/repos/monarch-initiative/mondo/releases?per_page=5",
        "https://mondo.monarchinitiative.org/pages/releases/"
      ]
    },
    {
      "unitId": "GENE_ONTOLOGY",
      "selectionPriority": 2,
      "urls": [
        "https://obofoundry.org/ontology/go.html",
        "https://api.github.com/repos/geneontology/go-ontology/releases?per_page=5",
        "https://geneontology.org/docs/download-ontology/"
      ]
    },
    {
      "unitId": "CELL_ONTOLOGY",
      "selectionPriority": 3,
      "urls": [
        "https://obofoundry.org/ontology/cl.html",
        "https://api.github.com/repos/obophenotype/cell-ontology/releases?per_page=5",
        "https://obophenotype.github.io/cell-ontology/"
      ]
    }
